# Copia este archivo como .env y completa los valores. .env nunca se sube al repo.

# Base de datos (la usan Postgres, Liquibase y la API)
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_DB=marketplace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Wompi (sandbox). Llaves en el panel de comercios de Wompi.
# La pública puede llegar al frontend; las otras dos solo viven en el servidor.
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxx
